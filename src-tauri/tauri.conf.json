{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevStation",
  "version": "0.2.0",
  "identifier": "vn.pontea.devstation",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DevStation",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0d1117",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2RTFCNzk0N0QyRDhEQTkKUldTcGpTMTlsTGZoMXJMNnRPT1krZjdBeXN0cGJWV2FQSnR3dW5QS2NFcXYvLyttbWlhbDRSMlcK",
      "endpoints": [
        "https://github.com/thang997/devstation/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
